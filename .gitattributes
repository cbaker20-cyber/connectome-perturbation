# Keep hashed research evidence byte-identical across operating systems.
/docs/pcdr/evidence/** -text whitespace=cr-at-eol

# The recorded eigencircuit sources use LF line endings.
/eigencircuits/*.py text eol=lf

# Research scripts retain their recorded bytes; do not normalize frozen hashes.
/scripts/pcdr*.py -text whitespace=cr-at-eol
/scripts/pcdr_array.sh text eol=lf
